{
  "appId": "com.chefbastion.game",
  "appName": "Chef Bastion",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#451a03",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#451a03",
      "showSpinner": false
    }
  }
}
